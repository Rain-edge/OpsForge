# Windows 开发机（core.autocrlf=true）fresh clone 后脚本必须是 LF，否则容器
# entrypoint 与 bash 脚本因 \r 全部失效（Windows + WSL2 环境实测）。
*.sh text eol=lf
lab/nodes/entrypoint.sh text eol=lf
lab/nodes/.env.example text eol=lf
docs/docker/** text eol=lf
# lab/ 下新增注册副本与前端 overlay，固定 LF 防 CRLF 翻转污染
# "对原件 diff 仅注册行"的复查（Dockerfile/spug_routing.py/routes.js 等）
lab/** text eol=lf
