# {{ ansible_managed }}
# Sentinel systemd 单元（Debian 12 redis 包不含 redis-sentinel.service，
# 以 redis-server --sentinel 方式自建，风格对齐官方 redis-server.service）
[Unit]
Description=Redis Sentinel (OpsForge {{ inventory_hostname }})
After=network.target
Documentation=https://redis.io/docs/management/sentinel/

[Service]
Type=notify
ExecStart=/usr/bin/redis-server /etc/redis/sentinel.conf --sentinel --supervised systemd --daemonize no
ExecStop=/bin/kill -s TERM $MAINPID
Restart=always
User=redis
Group=redis
RuntimeDirectory=redis
RuntimeDirectoryMode=0755
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
